<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing premium outer ring helper -->
    <path
        android:pathData="M54,16 A38,38 0 1,1 53.9,16 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#3F377A"/>

    <!-- Premium Luxury Ledger book/vault silhouette with golden gradients -->
    <path
        android:pathData="M34,28 c-3,0 -5,2 -5,5 v42 c0,3 2,5 5,5 h40 c3,0 5,-2 5,-5 v-42 c0,-3 -2,-5 -5,-5 Z"
        android:fillColor="#151329" />

    <!-- Ledger Spine & Accent Line -->
    <path
        android:pathData="M29,33 v42 c0,3 2,5 5,5 h4 v-52 h-4 c-3,0 -5,2 -5,5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="29"
                android:startY="33"
                android:endX="38"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFD700" />
                <item android:offset="1.0" android:color="#FFA500" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ledger Cover Right Half -->
    <path
        android:pathData="M38,28 h36 c3,0 5,2 5,5 v42 c0,3 -2,5 -5,5 h-36 Z"
        android:fillColor="#1C183F" />

    <!-- Isometric Ledger Pages Accent (the white paper margin) -->
    <path
        android:pathData="M73,31 h2 v40 h-2 Z"
        android:fillColor="#E2E8F0" />

    <!-- Gold Premium Embossed Seal / Vault Ring on Cover -->
    <path
        android:pathData="M56,54 a12,12 0 1,1 24,0 a12,12 0 1,1 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="56"
                android:startY="42"
                android:endX="80"
                android:endY="66"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE875" />
                <item android:offset="0.5" android:color="#F59E0B" />
                <item android:offset="1.0" android:color="#D97706" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner dark seal core -->
    <path
        android:pathData="M60,54 a8,8 0 1,1 16,0 a8,8 0 1,1 -16,0"
        android:fillColor="#151329" />

    <!-- Elegant 'L' branding inside the ledger cover in pure gold -->
    <path
        android:pathData="M65,49 v9 h5 v1.5 h-6.5 v-10.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="63"
                android:startY="48"
                android:endX="70"
                android:endY="60"
                android:type="linear">
                <item android:offset="0" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#FBBF24" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Decorative Gold diagonal strap representing a bookkeeping ledger band -->
    <path
        android:pathData="M42,28 l32,52 h5 l-32,-52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="28"
                android:endX="79"
                android:endY="80"
                android:type="linear">
                <item android:offset="0.0" android:color="#818CF8" />
                <item android:offset="0.5" android:color="#6366F1" />
                <item android:offset="1.0" android:color="#4F46E5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Small Golden star emblem (Sparkle) at top-right -->
    <path
        android:pathData="M81,25 l1,3 l3,1 l-3,1 l-1,3 l-1,-3 l-3,-1 l3,-1 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="78"
                android:startY="22"
                android:endX="84"
                android:endY="30"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFBEB" />
                <item android:offset="1.0" android:color="#FBBF24" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
